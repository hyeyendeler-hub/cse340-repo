<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Welcome</p>
      <h1>Home</h1>
      <p>
        Community Hub connects people, organizations, and projects in one simple and inspiring place.
      </p>
      <a class="button" href="/organizations">Explore organizations</a>
    </div>
    <div class="hero-visual">
      <img src="/images/hero-illustration.svg" alt="People collaborating around a project board" />
    </div>
  </div>
</section>

<section class="content-section">
  <div class="container three-column">
    <article class="card">
      <h2>Organizations</h2>
      <p>Discover community-led groups focused on outreach, events, advocacy, and support.</p>
    </article>
    <article class="card">
      <h2>Projects</h2>
      <p>Browse active initiatives and meaningful work happening across the network.</p>
    </article>
    <article class="card">
      <h2>Categories</h2>
      <p>Find connections by topic, including health, education, sustainability, and more.</p>
    </article>
  </div>
</section>
<%- include('partials/footer') %>
