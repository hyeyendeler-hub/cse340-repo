<%- include('partials/header') %>
<section class="content-section">
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">Directory</p>
      <h1>Organizations</h1>
    </div>
    <div class="list-grid">
      <% const organizationLogos = ['/images/brightfuture-logo.png', '/images/greenharvest-logo.png', '/images/unityserve-logo.png']; %>
      <% organizations.forEach((organization, index) => { %>
        <article class="list-card">
          <div class="organization-gallery">
            <img class="organization-logo" src="<%= organizationLogos[index % organizationLogos.length] %>" alt="<%= organization.name %> logo" />
          </div>
          <h2><%= organization.name %></h2>
          <p><%= organization.description %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
