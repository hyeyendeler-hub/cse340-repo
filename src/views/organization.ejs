<%- include('partials/header') %>
<main>
    <article class="detail-shell">
        <div class="detail-header">
            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
            <div>
                <h1><%= title %></h1>
                <h2><%= organizationDetails.name %></h2>
            </div>
        </div>

        <p><%= organizationDetails.description %></p>

        <div class="detail-section">
            <h3>Service Projects</h3>
            <div class="card-grid">
                <% projects.forEach(project => { %>
                    <article class="data-card project-card">
                        <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                        <p><strong>Location:</strong> <%= project.location %></p>
                        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
                    </article>
                <% }) %>
            </div>
        </div>
        <div class="detail-section">
            <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
        </div>
    </article>
</main>
<%- include('partials/footer') %>