<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Registered Users</h2>

    <% if (users.length > 0) { %>
        <ul>
            <% users.forEach(user => { %>
                <li>
                    <strong>Name:</strong> <%= user.name %><br>
                    <strong>Email:</strong> <%= user.email %><br>
                    <strong>Role:</strong> <%= user.role_name %>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No registered users found.</p>
    <% } %>
</main>

<%- include('partials/footer') %>