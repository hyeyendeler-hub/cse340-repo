<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
<p><a href="/new-organization">Add a new organization</a></p>
        <% if (organizations && organizations.length > 0) { %>
            <p>Here are a few of our partner organizations:</p>
            <div class="card-grid">
                <% organizations.forEach(organization => { %>
                    <article class="data-card organization-card">
                        <div class="card-header">
                            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                            <h3><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h3>
                        </div>
                        <p><%= organization.description %></p>
                        <p><strong>Email:</strong> <%= organization.contact_email %></p>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <p>No partner organizations are available yet.</p>
        <% } %>
    </main>

<%- include('partials/footer') %>
