<%- include('partials/header') %>
<section class="content-section">
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">Directory</p>
      <h1>Organizations</h1>
    </div>
    <div class="list-grid">
      <% const fallbackImages = ['/images/greenharvest-logo.png', '/images/brightfuture-logo.png', '/images/unityserve-logo.png']; %>
      <% organizations.forEach((organization, organizationIndex) => { %>
        <article class="list-card">
          <div class="organization-gallery">
            <% [organization.image_one, organization.image_two, organization.image_three].forEach((image, imageIndex) => { %>
              <img class="organization-logo" src="<%= image %>" onerror="this.onerror=null; this.src='<%= fallbackImages[(organizationIndex + imageIndex) % fallbackImages.length] %>';" alt="<%= imageIndex === 0 ? organization.name + ' logo' : '' %>" />
            <% }); %>
          </div>
          <h2><%= organization.name %></h2>
          <p><%= organization.description %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>