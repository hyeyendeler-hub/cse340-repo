<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>

        <% if (organizations && organizations.length > 0) { %>
            <p>Here are a few of our partner organizations:</p>
            <ul>
                <% organizations.forEach(organization => { %>
                    <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><strong><%= organization.name %></strong>: <%= organization.description %> - <%= organization.contact_email %></li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No partner organizations are available yet.</p>
        <% } %>
    </main>

<%- include('partials/footer') %>