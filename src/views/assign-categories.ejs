<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= projectDetails.title %></h2>

    <form action="/assign-categories/<%= projectId %>" method="POST">
        <fieldset>
            <legend>Select categories for this project</legend>
            <% if (categories.length === 0) { %>
                <p>No categories are available. Create one before assigning categories.</p>
            <% } else { %>
                <% categories.forEach((category) => { %>
                    <div class="form-group">
                        <label>
                            <input
                                type="checkbox"
                                name="categoryIds"
                                value="<%= category.category_id %>"
                                <%= assignedCategories.some((assigned) => assigned.category_id === category.category_id) ? 'checked' : '' %>
                            >
                            <%= category.category_name %>
                        </label>
                    </div>
                <% }); %>
            <% } %>
        </fieldset>

        <button type="submit">Save Categories</button>
    </form>
</main>
<%- include('partials/footer') %>
