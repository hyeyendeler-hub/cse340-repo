<%- include('partials/header') %>
<section class="content-section">
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">Current Work</p>
      <h1>Projects</h1>
    </div>
    <div class="list-grid">
      <% projects.forEach((project) => { %>
        <article class="list-card">
          <h2><%= project.name %></h2>
          <p><%= project.description %></p>
          <p class="metadata"><strong>Organization:</strong> <%= project.organization_name %></p>
          <p class="metadata"><strong>Category:</strong> <%= project.category_name %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>