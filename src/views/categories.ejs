<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <p>Browse service projects by category:</p>
    <div class="card-grid category-grid">
        <% categories.forEach(category => { %>
            <article class="data-card category-card">
                <h3><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></h3>
            </article>
        <% }) %>
    </div>
</main>
<%- include('partials/footer') %>