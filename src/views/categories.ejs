<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <p><a href="/new-category">Add a New Category</a></p>

    <p>Browse service projects by category:</p>
    <div class="card-grid category-grid">
        <% categories.forEach(category => { %>
            <article class="data-card category-card">
                <div>
                    <h3><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></h3>
                    <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>
                </div>
            </article>
        <% }) %>
    </div>
</main>
<%- include('partials/footer') %>