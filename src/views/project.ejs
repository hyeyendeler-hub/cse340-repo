<%- include('partials/header') %>
<main>
    <article class="detail-shell">
        <h1><%= title %></h1>
        <h2><%= projectDetails.title %></h2>

        <p><%= projectDetails.description %></p>
        <p><strong>Location:</strong> <%= projectDetails.location %></p>
        <p><strong>Date:</strong> <%= new Date(projectDetails.date).toLocaleDateString() %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

        <div class="detail-section">
            <h3>Categories</h3>
            <div class="card-grid category-grid">
                <% categories.forEach(category => { %>
                    <article class="data-card category-card">
                        <h3><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></h3>
                    </article>
                <% }) %>
            </div>
        </div>
    </article>
</main>
<%- include('partials/footer') %>